+int hdt_punch_begin(hdt_punch *p, const hdt_peer_info *info, const hdt_addr *rendezvous,
+                    const hdt_addr *external, const hdt_addr *observers, size_t observer_count,
+                    const uint8_t key[32], const uint8_t keys[128], uint16_t tid) {
+    if (!info->relay_count || !external->port) return 0;
+    size_t chosen = 0;
+    while (chosen + 1 < info->relay_count &&
+           !hdt_addr_equal(&info->relays[chosen].relay, rendezvous)) ++chosen;
+    if (!hdt_addr_equal(&info->relays[chosen].relay, rendezvous)) chosen = 0;
+    p->relay = info->relays[chosen].relay;
+    p->peer = info->relays[chosen].peer;
+    p->external = *external;
+    p->observed = 1;
+    p->id = info->punch_id;
+    p->remote_id = info->udx_id;
+    p->remote_seq = info->udx_seq;
+    p->tid = tid + 1u;
+    for (size_t i = 0; i < observer_count && i < HDT_PUNCH_OBSERVERS; ++i) {
+        if (!observers[i].port || hdt_addr_equal(&observers[i], rendezvous)) continue;
+        size_t j = 0;
+        while (j < p->observers_count && !hdt_addr_equal(&observers[i], &p->observers[j])) ++j;
+        if (j == p->observers_count) p->observers[p->observers_count++] = observers[i];
+    }
+    if (p->observers_count < 2) return 0;
+    memcpy(p->keys, keys, sizeof(p->keys));
+    randombytes_buf(p->token, sizeof(p->token));
+    return !crypto_generichash(p->secret, sizeof(p->secret), ns_punch, sizeof(ns_punch), keys + 64, 64) &&
+           !crypto_generichash(p->target, sizeof(p->target), key, 32, NULL, 0);
+}
+
+static size_t control(const hdt_punch *p, uint8_t *packet, size_t cap) {
+    uint8_t plain[MAX_PLAINTEXT], sealed[MAX_PLAINTEXT + 40], value[MAX_PLAINTEXT + 56];
+    unsigned commit = p->phase == COMMIT;
+    writer w = {plain, sizeof(plain), 1};
+    write_uint(&w, HAS_ADDRESSES | (commit ? PUNCHING | HAS_TOKEN | HAS_REMOTE_TOKEN : 0));
+    write_uint(&w, 0);
+    write_uint(&w, CONSISTENT);
+    write_uint(&w, p->round);
+    write_uint(&w, 1);
+    write_addr(&w, p->external);
+    if (commit) {
+        put(&w, p->token, sizeof(p->token));
+        put(&w, p->remote_token, sizeof(p->remote_token));
+    }
+    size_t size = sizeof(plain) - w.left;
+    randombytes_buf(sealed, 24);
+    int ok = w.ok && !crypto_secretbox_easy(sealed + 24, plain, size, sealed, p->secret);
+    sodium_memzero(plain, sizeof(plain));
+    if (!ok) return 0;
+
+    w = (writer){value, sizeof(value), 1};
+    write_uint(&w, 1); /* peerAddress present */
+    write_uint(&w, 0); /* FROM_CLIENT */
+    write_uint(&w, p->id);
+    write_uint(&w, size + 40);
+    put(&w, sealed, size + 40);
+    write_addr(&w, p->peer);
+    if (!w.ok) return 0;
+    hdt_rpc request = {0};
+    request.type = HDT_RPC_REQUEST;
+    request.flags = HDT_HAS_TARGET | HDT_HAS_VALUE;
+    request.tid = p->tid;
+    request.observed = p->relay;
+    request.command = 1;
+    request.target = p->target;
+    request.value = (hdt_slice){value, sizeof(value) - w.left};
+    return hdt_rpc_encode(&request, packet, cap);
+}
+
+static void advance(hdt_punch *p, uint8_t phase) {
+    p->phase = phase;
+    p->attempts = 0;
+    ++p->tid;
+}
+
+size_t hdt_punch_poll(hdt_punch *p, uint64_t now, hdt_addr *to, uint8_t *packet, size_t cap,
+                      int *failed) {
+    *failed = 0;
+    if (!cap) return 0;
+    if (!p->active) { p->started = now; p->active = 1; }
+    if (now - p->started >= 16000) { *failed = 1; return 0; }
+
+    if (p->phase == SAMPLE &&
+        (!p->attempts || now - p->last_send >= 700)) {
+        if (p->attempts == 2) {
+            ++p->next_observer;
+            advance(p, SAMPLE);
+        }
+        if (p->next_observer == p->observers_count) { *failed = 1; return 0; }
+        *to = p->observers[p->next_observer];
+        hdt_rpc ping = {0};
+        ping.type = HDT_RPC_REQUEST;
+        ping.flags = HDT_INTERNAL;
+        ping.tid = p->tid;
+        ping.observed = *to;
+        size_t size = hdt_rpc_encode(&ping, packet, cap);
+        if (size) { p->last_send = now; ++p->attempts; }
+        return size;
+    }
+
+    if ((p->phase == PROBE || p->phase == COMMIT) &&
+        (!p->attempts || now - p->last_send >= 1400)) {
+        if (p->attempts == RETRIES) { *failed = 1; return 0; }
+        *to = p->relay;
+        size_t size = control(p, packet, cap);
+        if (size) { p->last_send = now; ++p->attempts; }
+        return size;
+    }
+
+    if ((p->phase == COMMIT || p->phase == DIRECT) &&
+        (!p->probe_sent || now - p->last_probe >= 400)) {
+        *to = p->peer;
+        packet[0] = 0;
+        p->probe_sent = 1;
+        p->last_probe = now;
+        return 1;
+    }
+    return 0;
+}
+
+static int decision(hdt_punch *p, hdt_slice value) {
+    reader r = {value.data, value.size, 1};
+    uint64_t flags = read_uint(&r);
+    if (flags != 1 || read_uint(&r) != 4 || read_uint(&r) != 0) return 0;
+    hdt_slice sealed = read_buffer(&r);
+    hdt_addr peer = read_addr(&r);
+    uint8_t plain[MAX_PLAINTEXT];
+    if (!r.ok || r.left || !peer.port || sealed.size <= 40 ||
+        sealed.size - 40 > sizeof(plain) ||
+        crypto_secretbox_open_easy(plain, sealed.data + 24, sealed.size - 24, sealed.data, p->secret)) return 0;
+    r = (reader){plain, sealed.size - 40, 1};
+    flags = read_uint(&r);
+    uint64_t error = read_uint(&r), firewall = read_uint(&r), round = read_uint(&r);
+    uint64_t count = flags & HAS_ADDRESSES ? read_uint(&r) : 0;
+    int address_matches = 0;
+    if (count > MAX_ADDRESSES) r.ok = 0;
+    for (size_t i = 0; r.ok && i < count; ++i) {
+        hdt_addr candidate = read_addr(&r);
+        if (hdt_addr_equal(&candidate, &peer)) address_matches = 1;
+    }
+    if (flags & 8u) (void)read_addr(&r);
+    const uint8_t *token = flags & HAS_TOKEN ? take(&r, 32) : NULL;
+    const uint8_t *remote = flags & HAS_REMOTE_TOKEN ? take(&r, 32) : NULL;
+    int result = 0;
+    if (!r.ok || r.left || flags > 63 || round != p->round) goto done;
+    if (error || firewall > CONSISTENT) { result = -1; goto done; }
+
+    if (p->phase == PROBE) {
+        if (!firewall || !token) {
+            if (++p->round >= RETRIES) { result = -1; goto done; }
+            advance(p, PROBE);
+            goto done;
+        }
+        if (!address_matches) { result = -1; goto done; }
+        p->peer = peer;
+        memcpy(p->remote_token, token, 32);
+        ++p->round;
+        advance(p, COMMIT);
+    } else {
+        if (!(flags & PUNCHING) || !address_matches || !hdt_addr_equal(&peer, &p->peer) ||
+            !remote || sodium_memcmp(remote, p->token, 32)) {
+            result = -1;
+            goto done;
+        }
+        advance(p, DIRECT);
+        result = p->peer_seen;
+    }
+done:
+    sodium_memzero(plain, sizeof(plain));
+    return result;
+}
+
+int hdt_punch_receive(hdt_punch *p, const hdt_addr *from, const uint8_t *packet, size_t size) {
+    if (size == 1 && packet[0] == 0 && p->probe_sent &&
+        (p->phase == COMMIT || p->phase == DIRECT) && hdt_addr_equal(from, &p->peer)) {
+        p->peer_seen = 1;
+        return p->phase == DIRECT;
+    }
+    if (!p->attempts || p->phase == DIRECT) return 0;
+    const hdt_addr *expected = p->phase == SAMPLE ? &p->observers[p->next_observer] : &p->relay;
+    hdt_rpc response;
+    if (!hdt_addr_equal(from, expected) || !hdt_rpc_decode(packet, size, &response) ||
+        response.type != HDT_RPC_RESPONSE || response.tid != p->tid || response.error) return 0;
+    if (p->phase == SAMPLE) {
+        if (!hdt_addr_equal(&response.observed, &p->external)) return -1;
+        ++p->next_observer;
+        advance(p, ++p->observed >= 3 ? PROBE : SAMPLE);
+        return 0;
+    }
+    return (response.flags & HDT_HAS_VALUE) ? decision(p, response.value) : 0;
+}
