+/* SPDX-License-Identifier: LGPL-3.0-only
+ * Bounded adaptation of hyperdht-cpp/src/holepunch.cpp.
+ * Stock HyperDHT initiator profile for matching external IPv4 mappings.
+ */
+#ifndef HDT_PUNCH_H
+#define HDT_PUNCH_H
+#include "handshake.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum { HDT_PUNCH_OBSERVERS = 3 };
+
+typedef struct {
+    hdt_addr relay, peer, external, observers[HDT_PUNCH_OBSERVERS];
+    uint8_t secret[32], target[32], token[32], remote_token[32], keys[128];
+    uint64_t last_send, last_probe, started;
+    uint32_t id, remote_id, remote_seq;
+    uint16_t tid;
+    uint8_t phase, observed, next_observer, observers_count, attempts, round;
+    uint8_t active, probe_sent, peer_seen;
+} hdt_punch;
+
+int hdt_punch_begin(hdt_punch *p, const hdt_peer_info *info, const hdt_addr *rendezvous,
+                    const hdt_addr *external, const hdt_addr *observers, size_t observer_count,
+                    const uint8_t key[32], const uint8_t keys[128], uint16_t tid);
+size_t hdt_punch_poll(hdt_punch *p, uint64_t now, hdt_addr *to, uint8_t *packet, size_t cap,
+                      int *failed);
+/* 1: an authenticated control round and a direct probe succeeded.
+ * 0: keep polling. -1: a peer-authenticated error or inconsistent mapping. */
+int hdt_punch_receive(hdt_punch *p, const hdt_addr *from, const uint8_t *packet, size_t size);
+#ifdef __cplusplus
+}
+#endif
